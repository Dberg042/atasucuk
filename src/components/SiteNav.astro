---
import LanguageSwitcher from './LanguageSwitcher.astro';
import { blogHref } from '../i18n/recipes';
import { useV5 } from '../i18n/v5';
import type { Lang } from '../i18n/ui';

// Ortak üst menü — ana sayfa ve blog sayfaları aynı bileşeni kullanır.
// variant:
//   'overlay' → hero görselinin üzerine biner (açık renk metin), ana sayfa.
//   'solid'   → akışın içinde, krem zeminli, koyu metin; blog gibi açık
//               arka planlı sayfalarda overlay metni görünmez olduğu için.
interface Props { lang: Lang; variant?: 'overlay' | 'solid' }
const { lang, variant = 'overlay' } = Astro.props;
const t = useV5(lang);
const homeHref = lang === 'no' ? '/' : `/${lang}/`;
---

<nav class:list={['nav', variant === 'solid' && 'nav--solid']}>
  <div class="container nav__inner">
    <a class="brand" href={homeHref} aria-label={t('nav.brand')}>
      <svg class="ico ico-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12.5" cy="8.5" r="2.5"></circle><path d="M12.5 2a6.5 6.5 0 0 0-6.22 4.6c-1.1 3.13-.78 3.9-3.18 6.08A3 3 0 0 0 5 18c4 0 8.4-1.8 11.4-4.3A6.5 6.5 0 0 0 12.5 2Z"></path><path d="m18.5 6 2.19 4.5a6.48 6.48 0 0 1 .31 2 6.49 6.49 0 0 1-2.6 5.2C15.4 20.2 11 22 7 22a3 3 0 0 1-2.68-1.66L2.4 16.5"></path></svg>
      <span class="brand__name">{t('nav.brand')}</span>
    </a>
    {/* Blog + dil seçimi sağda; aralarında belirgin boşluk. Dil seçimi
         localStorage'a kaydedilir, Base'deki otomatik yönlendirme buna uyar. */}
    <div class="nav__right">
      <a class="nav__link" href={blogHref(lang)}>{t('nav.blog')}</a>
      <LanguageSwitcher />
    </div>
  </div>
</nav>
