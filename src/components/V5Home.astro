---
import Base from '../layouts/Base.astro';
import Survey from './Survey.astro';
import SiteNav from './SiteNav.astro';
import { useV5 } from '../i18n/v5';
import { recipes, recipeHref, blogHref, pickL } from '../i18n/recipes';
import { dirFor, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useV5(lang);
const v5href = (l: Lang) => (l === 'no' ? '/' : `/${l}/`);
const privacyHref = lang === 'no' ? '/personvern' : `/${lang}/personvern`;
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
const msgAttrs = {
  'data-msg-sending': t('form.sending'),
  'data-msg-ok': t('form.ok'),
  'data-msg-already': t('form.already'),
  'data-msg-error': t('form.error'),
};

// Fiyat barı segmentleri: kırmızı = gerçek değer, gri = aracı/maliyet katmanı.
// w = segmentin genişliği (bar yüzdesi) — buradan elle ayarlanır.
// İthal barın toplamı 100 (tam genişlik); Ata barının toplamı ne kadar küçükse
// bar o kadar kısa görünür (şu an 26+16 = 42 → ithalin ~%42'si).
const importSegs = [
  { k: 'price.seg_ravare', w: 18, c: 'ravare' },
  { k: 'price.seg_produksjon', w: 14, c: 'produksjon' },
  { k: 'price.seg_transport', w: 11, c: 'extra' },
  { k: 'price.seg_toll', w: 29, c: 'extra' },
  { k: 'price.seg_mellomledd', w: 10, c: 'extra' },

  { k: 'price.seg_mellomledd', w: 18, c: 'extra' },
] as const;
const ataSegs = [
  { k: 'price.seg_ravare', w: 26, c: 'ravare' },
  { k: 'price.seg_produksjon', w: 20, c: 'produksjon' },
] as const;
---

<Base lang={lang} dir={dirFor(lang)} title={t('meta.title')} description={t('meta.description')}>
  <SiteNav lang={lang} />

  {/* Seksjon 1 — Hero */}
  <header class="hero">
    <div class="hero__overlay" aria-hidden="true"></div>
    <div class="container hero__inner">
      <div class="hero__badge"><span class="hero__badge-dot" aria-hidden="true"></span><span>{t('hero.badge')}</span></div>
      {/* Akış başlık: üç parça tek cümle gibi, eşit boy/ağırlık (Inter);
          highlight "Rettferdig pris"te. Damga satırı ayrı blok kalır. */}
      <h1 class="hero__title hero__title--flow">
        <span>{t('hero.title_top')}. <span class="hero__title-accent--gold">{t('hero.title_pre')}.</span> {t('hero.title_accent')}.</span>
        <span class="hero__title-line--stamp">{t('hero.title_post')}</span>
      </h1>

      {/* Tek CTA: venteliste (çekiliş scroll popup'ına taşındı) — panel başlığı içeride */}
      <div class="hero__form-panel">
        <p class="hero__panel-heading">{t('hero.waitlist_heading')}</p>
        <form class="signup" data-signup data-source="v5_hero" {...msgAttrs}>
          <label class="sr-only" for="v5-hero-email">{t('hero.email_label')}</label>
          <input class="signup__input" id="v5-hero-email" name="email" type="email" inputmode="email" autocomplete="email" required placeholder={t('hero.email_placeholder')} />
          <button class="signup__btn signup__btn--primary" type="submit"><span>{t('hero.cta')}</span></button>
          {turnstileSiteKey && <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-size="flexible" data-appearance="interaction-only"></div>}
          <p class="signup__status" role="status" aria-live="polite"></p>
        </form>
      </div>

      {/* Sosyal kanıt: onaylı (double opt-in tamamlanmış) kayıt sayısı.
          API'den tarayıcıda çekilir, site statik kalır. Eşiğin altındaysa ya da
          API'ye ulaşılamazsa gizli kalır — bkz. sayfa sonundaki script. */}
      <p class="hero__count" hidden>
        {t('proof.counter_pre')} <strong data-count>—</strong> {t('proof.counter_post')}
      </p>

      {/* Lead metni en altta: merak eden okur (bold vurgular için set:html) */}
      <p class="hero__lead hero__lead--after" set:html={t('hero.lead')}></p>
    </div>
  </header>

  <main>
    {/* Seksjon 2 — Trust-stripe */}
    <div class="trust">
      <div class="container">
        <div class="trust__grid">
          <div class="trust__item">
            <svg class="ico ico-6 trust__ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path><path d="m9 12 2 2 4-4"></path></svg>
            <span>{t('trust.halal')}</span>
          </div>
          <div class="trust__item">
            <svg class="ico ico-6 trust__ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"></path><circle cx="12" cy="10" r="3"></circle></svg>
            <span>{t('trust.local')}</span>
          </div>
          <div class="trust__item">
            <svg class="ico ico-6 trust__ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            <span>{t('trust.fermented')}</span>
          </div>
        </div>
      </div>
    </div>

    {/* Seksjon 3 — Problem: tek zincir (import → katkı VE fiyat) + pris + Ata-måten */}
    <section class="section problem">
      <div class="container">
        <div class="section-head" data-reveal>
          <h2 class="section-head__title">{t('problem.title')}</h2>
          <p class="section-head__lead">{t('problem.lead')}</p>
        </div>

        <div class="cards" data-reveal>
          <div class="card">
            <div class="card__icon card__icon--muted">
              <svg class="ico ico-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            </div>
            <h3 class="card__title">{t('problem.p1_title')}</h3>
            <p class="v5-problem__text">{t('problem.p1_text')}</p>
          </div>
          <div class="card">
            <div class="card__icon card__icon--muted">
              <svg class="ico ico-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" x2="12" y1="2" y2="22"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
            </div>
            <h3 class="card__title">{t('problem.p2_title')}</h3>
            <p class="v5-problem__text">{t('problem.p2_text')}</p>
          </div>
        </div>

        <p class="v5-punchline" data-reveal>{t('problem.punchline')}</p>

        <div class="pricebar" data-reveal>
          <div class="pricebar__row">
            <div class="pricebar__head"><span>{t('price.bar_import_label')}</span><strong>{t('price.bar_import_value')}</strong></div>
            <div class="pricebar__track">
              {importSegs.map((s) => (
                <div class={`pricebar__seg pricebar__seg--${s.c}`} style={`--w:${s.w}%`}><span>{t(s.k as any)}</span></div>
              ))}
            </div>
          </div>
          <div class="pricebar__row">
            <div class="pricebar__head"><span>{t('price.bar_ata_label')}</span><strong class="pricebar__value-ata">{t('price.bar_ata_value')}</strong></div>
            <div class="pricebar__track">
              {ataSegs.map((s) => (
                <div class={`pricebar__seg pricebar__seg--${s.c}`} style={`--w:${s.w}%`}><span>{t(s.k as any)}</span></div>
              ))}
            </div>
          </div>
          <div class="pricebar__legend">
            <span><i class="dot dot--ravare"></i>{t('price.seg_ravare')} + {t('price.seg_produksjon')}</span>
            <span><i class="dot dot--extra"></i>{t('price.seg_toll')} + {t('price.seg_transport')} + {t('price.seg_mellomledd')}</span>
          </div>
        </div>

        {/* Ata-måten — problemi kökünden çözen pozitif (yeşil) blok */}
        <div class="v5-ata" data-reveal>
          <div class="card card--dark card--positive">
            <div class="card__blob" aria-hidden="true"></div>
            <div class="card__icon card__icon--gold">
              <svg class="ico ico-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21.801 10A10 10 0 1 1 17 3.335"></path><path d="m9 11 3 3L22 4"></path></svg>
            </div>
            <h3 class="card__title">{t('ata.title')}</h3>
            <p class="v5-ata__intro">{t('ata.intro')}</p>
            <ul class="card__list">
              {['ata.b1', 'ata.b2'].map((k) => (
                <li class="card__item">
                  <svg class="ico ico-5 card__bullet card__bullet--good" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>
                  <span>{t(k as any)}</span>
                </li>
              ))}
            </ul>
            <p class="v5-ata__outro">{t('ata.outro')}</p>
          </div>
        </div>
      </div>
    </section>

    {/* Hva er sucuk? (resim + yazı) */}
    <section class="section whatis">
      <div class="container whatis__grid" data-reveal>
        <div class="whatis__media">
          <img src="/assets/sucukh.jpg" alt={t('whatis.title')} width="1536" height="1024" loading="lazy" />
        </div>
        <div class="whatis__text">
          <h2 class="section-head__title">{t('whatis.title')}</h2>
          <p class="whatis__lead">{t('whatis.text')}</p>
          <div class="whatis__tags">
            <span class="offer__tag">{t('whatis.tag1')}</span>
            <span class="offer__tag">{t('whatis.tag2')}</span>
            <span class="offer__tag">{t('whatis.tag3')}</span>
          </div>
        </div>
      </div>
    </section>

    {/* Tarifler (3 kart → blog) */}
    <section class="section recipes">
      <div class="container">
        <div class="section-head" data-reveal>
          <h2 class="section-head__title">{t('recipes.title')}</h2>
          <p class="section-head__lead">{t('recipes.lead')}</p>
          <a class="post__back" href={blogHref(lang)}>{t('recipes.see_all')}</a>
        </div>
        <div class="recipes__grid">
          {recipes.map((r) => (
            <a class="recipe" href={recipeHref(lang, r.slug)} data-reveal>
              <div class={`recipe__media recipe__media--${r.tone}`}>
                <img class="recipe__img" src={r.image} alt={pickL(r.title, lang)} loading="lazy" />
                <span class="recipe__time">⏱ {pickL(r.time, lang)}</span>
              </div>
              <div class="recipe__body">
                <h3 class="recipe__title">{pickL(r.title, lang)}</h3>
                <p class="recipe__excerpt">{pickL(r.excerpt, lang)}</p>
                <span class="recipe__cta">{t('recipes.cta')}</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    {/* Seksjon 4 — İçindekiler: saf kanıt, tek cümle (koyu, v7 kurgusu) */}
    <section class="section trust-offer">
      <div class="container">
        <div class="section-head" data-reveal>
          <h2 class="section-head__title">{t('ing.title')}</h2>
          <p class="v5-ing__sentence">{t('ing.sentence')}</p>
          <p class="section-head__lead">{t('ing.text')}</p>
        </div>

        <div class="trust-offer__media" data-reveal>
          <img src="/assets/middle.png" alt={t('ing.img_alt')} width="1536" height="1024" loading="lazy" />
        </div>
      </div>
    </section>

    {/* Seksjon 5 — Lansering + levering (v4'teki offer'ın yerine) */}
    <section class="section launch">
      <div class="container container--narrow launch__inner" data-reveal>
        <div class="launch__icon">
          <svg class="ico ico-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 22h14"></path><path d="M5 2h14"></path><path d="M17 22v-4.172a2 2 0 0 0-.586-1.414L12 12l-4.414 4.414A2 2 0 0 0 7 17.828V22"></path><path d="M7 2v4.172a2 2 0 0 0 .586 1.414L12 12l4.414-4.414A2 2 0 0 0 17 6.172V2"></path></svg>
        </div>
        <h2 class="section-head__title">{t('launch.title')}</h2>
        <p class="launch__text">{t('launch.text')}</p>
        <div class="offer__tags">
          <span class="offer__tag offer__tag--light">{t('launch.tag1')}</span>
          <span class="offer__tag offer__tag--light">{t('launch.tag2')}</span>
          <span class="offer__tag offer__tag--light">{t('launch.tag3')}</span>
        </div>
      </div>
    </section>

    {/* Seksjon 6 — Gründerne (foto + hikâye + iletişim) */}
    <section class="section founder">
      <div class="container container--narrow founder__inner" data-reveal>
        <img class="founder__photo" src="/assets/founders.jpeg" alt={t('founder.img_alt')} width="320" height="320" loading="lazy" />
        <h2 class="section-head__title">{t('founder.title')}</h2>
        <p class="founder__text">{t('founder.text')}</p>
        <p class="founder__text">{t('founder.text2')}</p>
        <p class="founder__sign">{t('founder.sign')}</p>
      </div>
    </section>

    {/* Seksjon 7 — Anket + çekiliş: çerçeve katılım, gavekort "som takk" */}
    <section class="section engine">
      <div class="container container--narrow engine__inner" data-reveal>
        <div class="engine__icon">
          <svg class="ico ico-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 12h6"></path><path d="M9 16h6"></path><path d="M9 8h6"></path><rect width="16" height="20" x="4" y="2" rx="2"></rect></svg>
        </div>
        <h2 class="section-head__title">{t('engine.title')}</h2>
        <p class="engine__text">{t('engine.text')}</p>
        <p class="engine__text v5-engine__thanks">{t('engine.thanks')}</p>
        <button class="hero__survey-cta engine__btn" type="button" data-survey-open>🎁 {t('engine.button')}</button>
        <p class="engine__terms">{t('engine.terms')} <a href={privacyHref}>{t('engine.terms_link')}</a></p>
      </div>
    </section>

    {/* Seksjon 9 — Son CTA */}
    <section class="cta">
      <div class="cta__overlay" aria-hidden="true"></div>
      <div class="container container--narrow cta__inner">
        <h2 class="cta__title">{t('cta.title')}</h2>
        <p class="cta__lead">{t('cta.lead')}</p>
        <div class="cta__form-panel">
          <form class="signup signup--row" data-signup data-source="v5_footer" {...msgAttrs}>
            <label class="sr-only" for="v5-cta-email">{t('cta.email_label')}</label>
            <input class="signup__input" id="v5-cta-email" name="email" type="email" inputmode="email" autocomplete="email" required placeholder={t('cta.email_placeholder')} />
            <button class="signup__btn signup__btn--dark" type="submit">{t('cta.button')}</button>
            {turnstileSiteKey && <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-size="flexible" data-appearance="interaction-only"></div>}
            <p class="signup__status" role="status" aria-live="polite"></p>
          </form>
        </div>
      </div>
    </section>
  </main>

  {/* Seksjon 10 — Footer (iletişim + personvern) */}
  <footer class="footer">
    <div class="container footer__inner">
      <a class="brand" href={v5href(lang)} aria-label={t('nav.brand')}>
        <span class="brand__name brand__name--sm">{t('nav.brand')}</span>
      </a>
      <div class="footer__contact">
        <a href={`mailto:${t('footer.email')}`}>{t('footer.email')}</a>
        <span class="footer__sep">·</span>
        <a href={`tel:${t('footer.phone').replace(/\s/g, '')}`}>{t('footer.phone')}</a>
        <span class="footer__sep">·</span>
        <a href={privacyHref}>{t('footer.privacy')}</a>
      </div>
      <p class="footer__copy">{t('footer.copy')}</p>
    </div>
  </footer>

  {/* Scroll'da beliren anket daveti — çekiliş hero'dan buraya taşındı */}
  <aside class="survey-pop" data-survey-pop hidden>
    <button class="survey-pop__close" type="button" data-survey-pop-close aria-label={t('popup.dismiss')}>&times;</button>
    <p class="survey-pop__title">🎁 {t('popup.title')}</p>
    <p class="survey-pop__text">{t('popup.text')}</p>
    <button class="survey-pop__btn" type="button" data-survey-open>{t('popup.button')}</button>
  </aside>

  <Survey lang={lang} />
</Base>

<script>
  import '../scripts/signup.ts';
  import '../scripts/survey.ts';
  import '../scripts/reveal.ts';

  // Waitlist sayacı (SPEC-10 proof). Sayı sayfa açılışında API'den çekilir —
  // ayrı bir rebuild/cron gerekmez, her ziyaretçi güncel sayıyı görür.
  // Küçük sayı ters sosyal kanıt olur: eşiğin altında sayaç gizli kalır.
  // API'ye ulaşılamazsa da gizli kalır, bozuk bir şey görünmez.
  (async () => {
    const el = document.querySelector<HTMLElement>('[data-count]');
    const wrap = el?.closest<HTMLElement>('.hero__count');
    if (!el || !wrap) return;
    try {
      const r = await fetch(`${import.meta.env.PUBLIC_API_URL}/count`);
      if (!r.ok) return;
      const d = await r.json();
      const total = Number(d?.data?.total ?? 0);
      if (!Number.isFinite(total) || total < 25) return;
      el.textContent = new Intl.NumberFormat(document.documentElement.lang || 'no').format(total);
      wrap.hidden = false;
    } catch {
      /* sayaç gizli kalır */
    }
  })();

  // Anket popup'ı: ilk ekranı geçince bir kez belirir; kapatınca o oturumda
  // bir daha çıkmaz. Butonu Survey modalını açar (data-survey-open).
  (() => {
    const pop = document.querySelector<HTMLElement>('[data-survey-pop]');
    if (!pop) return;
    const KEY = 'surveyPopSeen';
    const seen = (() => {
      try { return sessionStorage.getItem(KEY); } catch { return null; }
    })();
    const hide = () => {
      pop.classList.remove('is-in');
      pop.hidden = true;
      try { sessionStorage.setItem(KEY, '1'); } catch { /* yoksay */ }
    };
    pop.querySelector('[data-survey-pop-close]')?.addEventListener('click', hide);
    pop.querySelector('[data-survey-open]')?.addEventListener('click', hide);
    if (seen) return;
    let shown = false;
    const onScroll = () => {
      if (shown) return;
      if (window.scrollY > window.innerHeight * 0.7) {
        shown = true;
        pop.hidden = false;
        requestAnimationFrame(() => pop.classList.add('is-in'));
        window.removeEventListener('scroll', onScroll);
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
  })();
</script>
