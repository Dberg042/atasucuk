---
import { activeLanguages, alternatePaths, getLangFromUrl, type Lang } from '../i18n/ui';

// page: dil değişiminde kalınacak alt sayfa ('' = ana sayfa, 'v7/' = v7 önizleme).
// Verilmezse bulunulan sayfanın karşılığına gidilir (alternatePaths) — blog gibi
// alt sayfalarda dil değiştirince ana sayfaya atmak yerine aynı yazıda kalınır.
interface Props { page?: string }
const { page } = Astro.props;
const current = getLangFromUrl(Astro.url);
const alternates = alternatePaths(Astro.url.pathname);
const href = (l: Lang) =>
  page === undefined
    ? (alternates.find((a) => a.lang === l)?.href ?? '/')
    : l === 'no'
      ? `/${page}`
      : `/${l}/${page}`;
---

<div class="langsel" role="navigation" aria-label="Språk / Dil">
  {
    activeLanguages.map((l, i) => (
      <>
        {i > 0 && <span class="langsel__sep" aria-hidden="true">·</span>}
        <a
          class:list={['langsel__link', { 'is-active': l === current }]}
          href={href(l)}
          data-lang={l}
          hreflang={l}
          aria-current={l === current ? 'true' : undefined}
        >
          {l.toUpperCase()}
        </a>
      </>
    ))
  }
</div>

<script is:inline>
  document.querySelectorAll('.langsel__link').forEach(function (a) {
    a.addEventListener('click', function () {
      try {
        localStorage.setItem('lang', a.getAttribute('data-lang'));
      } catch (e) {}
    });
  });
</script>
