---
import '../styles/global.css';
import { alternatePaths, defaultLang } from '../i18n/ui';

// T1.2 — temel layout. lang/dir prop'larıyla i18n + RTL'e hazır (T1.7/T1.9).
// Varsayılan değerler mevcut index.html ile birebir (NO).
export interface Props {
  title?: string;
  description?: string;
  lang?: string;
  dir?: 'ltr' | 'rtl';
  ogImage?: string;
}

const {
  title = 'Ata Sucuk | Norges første autentiske, lokalproduserte halal sucuk',
  description = 'Tradisjonelt fermentert. Ferske norske råvarer. Ekte tyrkisk smak – til en rettferdig pris. Meld deg på ventelisten for lansering.',
  lang = 'no',
  dir = 'ltr',
  ogImage = '/assets/hero.jpg',
} = Astro.props;

const ogImageUrl = new URL(ogImage, Astro.site ?? 'https://atasucuk.no').href;
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;

const siteOrigin = Astro.site ?? new URL('https://atasucuk.no');
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin).href;
const alternates = alternatePaths(Astro.url.pathname);
const xDefaultHref = new URL(alternates.find((a) => a.lang === defaultLang)!.href, siteOrigin).href;
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />

    {/* Google tag (gtag.js) */}
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-E07JD0Q7Q8"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-E07JD0Q7Q8');
    </script>

    {/* Canonical + hreflang (NO/TR/EN) — dil varyantları arasında duplicate-content sinyalini önler */}
    <link rel="canonical" href={canonicalUrl} />
    {alternates.map((a) => (
      <link rel="alternate" hreflang={a.lang} href={new URL(a.href, siteOrigin).href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={xDefaultHref} />

    {/* Favicon (hero'daki marka et/but ikonu) */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="mask-icon" href="/favicon.svg" color="#711A1B" />
    <meta name="theme-color" content="#711A1B" />

    {/* Open Graph */}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:type" content="website" />

    {/* Fonts (Inter + Playfair Display, mevcut referansla aynı) */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Oswald:wght@500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />

    {/* Dil algılama (T1.7): ilk ziyarette tarayıcı diline, sonra kayıtlı manuel
         seçime göre yönlendir. Aktif diller: no, tr. Diğerleri UI'da sunulmaz. */}
    <script is:inline>
      (function () {
        try {
          var active = ['no', 'tr', 'en'];
          var path = location.pathname;
          var seg = path.split('/')[1] || '';
          // Yalnız ana sayfalarda yönlendir (/, /tr/, /en/) — blog, personvern vb. dokunulmaz.
          var isHome = path === '/' || (active.indexOf(seg) >= 0 && /^\/[a-z]{2}\/?$/.test(path));
          if (!isHome) return;
          var current = active.indexOf(seg) >= 0 ? seg : 'no';
          var to = function (l) {
            // Query korunur — ?confirmed=1&code=… onay dönüşü parametreleri kaybolmasın.
            return (l === 'no' ? '/' : '/' + l + '/') + location.search;
          };
          var saved = localStorage.getItem('lang');
          if (saved && active.indexOf(saved) >= 0) {
            if (saved !== current) location.replace(to(saved));
            return;
          }
          var nav = (navigator.language || 'no').slice(0, 2).toLowerCase();
          if (active.indexOf(nav) >= 0 && nav !== current) location.replace(to(nav));
        } catch (e) {}
      })();
    </script>

    {/* Cloudflare Turnstile (fraud) — yalnız site key tanımlıysa */}
    {turnstileSiteKey && (
      <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    )}

    {/* JSON-LD: Organization (sitewide) */}
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: 'Ata Sucuk',
      url: String(siteOrigin),
      logo: new URL('/favicon.svg', siteOrigin).href,
    })} />
  </head>
  <body>
    <slot />
  </body>
</html>
